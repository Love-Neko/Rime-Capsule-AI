# .env.example
# Jev AI 与大模型本地配置模板
# 使用方法：复制本文件并重命名为 .env，填入您的 API Key 或本地模型参数。
# 注意：.env 文件已加入 .gitignore，绝不会被上传到 GitHub，保障您的密钥安全。

# 1. TypeSafe AI Jev 候选重排密钥（获取地址：https://console.typesafe.ai/keys）
TYPESAFE_API_KEY=your_typesafe_api_key_here

# 2. 本地 Ollama 大模型接入配置（可选）
LOCAL_OLLAMA_ENABLED=0
LOCAL_OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCAL_OLLAMA_MODEL=qwen3:8b
LOCAL_OLLAMA_TIMEOUT_SECONDS=20

# 3. Tab 智能联想长句预测（可选）
TAB_COMPLETION_BASE_URL=
TAB_COMPLETION_MODEL=qwen3:8b
TAB_COMPLETION_TIMEOUT_SECONDS=8
TAB_COMPLETION_MAX_TOKENS=48
